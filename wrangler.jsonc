{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scs-blog-worker",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "python_workers"
  ],

  "workers_dev": true,
  "preview_urls": false,

  "kv_namespaces": [
    {
      "binding": "KV_BINDING",
      "id": "323722b1e59942e4bbd617de59b4f91b"
    }
  ],

  "triggers": {
    "crons": [
      "5 8 * * *",
      "0 15 * * *",
      "5 15 * * *",
      "0 17 * * *",
      "30 17 * * *"
    ]
  }
}

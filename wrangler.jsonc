{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scs-blog-worker",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "python_workers"
  ],

  "workers_dev": true,
  "preview_urls": false,

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  "kv_namespaces": [
    {
      "binding": "KV_BINDING",
      "id": "323722b1e59942e4bbd617de59b4f91b"
    }
  ],

  "triggers": {
    "crons": [
      "5 8 * * *",
      "0 15,17 * * *",
      "5 15 * * *",
      "30 17 * * *"
    ]
  }
}
